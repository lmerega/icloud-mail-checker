{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "__MSG_appShortName__",
  "version": "0.1.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/lmerega/icloud-mail-checker",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "permissions": ["alarms", "notifications", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://*.icloud.com/*"],
  "background": { "service_worker": "service_worker.js", "type": "module" },
  "action": {
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" },
    "default_title": "__MSG_appName__",
    "default_popup": "popup/popup.html"
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "minimum_chrome_version": "121"
}
